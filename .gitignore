# the generated static website: built by scripts/build_website.py and published from
# .github/workflows/pages.yml, so the generated HTML and its figures are not committed
# (only the output directory at the repository root - src/qcog/website/ is package code)
/website/

# the model tests write their figures, their per-model reports and their summary here; the suite
# regenerates all of it in about a minute
model_tests/out/

# the showcase writes an accessible HTML report per model only when it is asked to
# (`python demos/showcase/run_showcase.py --reports`); the figures and the captured console
# output in the same directory are
demos/showcase/reports/
